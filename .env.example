# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/members_only
SESSION_SECRET=replace-with-a-long-random-text
# The word a person types on the join page to become a member
MEMBER_PASSCODE=change-me
# The word a person types on the join page to become an admin
ADMIN_PASSCODE=change-me-admin
PORT=3000
