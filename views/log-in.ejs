<%- include("partials/header") %>
<main class="container">
  <form class="login-card" action="/log-in" method="POST">
    <h1 class="logo-words"><span class="ink-block">Log</span> <span class="pink-block">in</span></h1>
    <% if (error) { %><p class="errors"><%= error %></p><% } %>
    <label>Email <input type="email" name="email" required></label>
    <label>Password <input type="password" name="password" required></label>
    <button type="submit">Let me in</button>
    <p><a href="/sign-up">New here? Get on the list</a></p>
  </form>
</main>
<%- include("partials/footer") %>
